# Ubuntu 反向代理示例：复制为 /etc/nginx/sites-available/rag-pilot 后按实际域名和证书修改。
# Docker Compose 仍监听 127.0.0.1:8088（生产环境不要再把 8088 对外放行）。
server {
    listen 80;
    server_name rag.example.internal;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name rag.example.internal;

    ssl_certificate     /etc/ssl/rag/rag.example.internal.crt;
    ssl_certificate_key /etc/ssl/rag/rag.example.internal.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
