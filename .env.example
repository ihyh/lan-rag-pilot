# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，严禁提交）
# 变量说明见 README.md「环境变量」一节；此处只列变量名，不写默认值。

# ---- DeepSeek API（服务端直连）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_S=

# ---- 安全 ----
# 会话令牌 HMAC 密钥：python -c "import secrets;print(secrets.token_urlsafe(48))"
RAG_SECRET_KEY=
# root 初始密码：仅在数据库尚无任何用户时用于创建 root
RAG_ROOT_PASSWORD=
RAG_COOKIE_SECURE=
RAG_SESSION_TTL_HOURS=

# ---- 对外地址 ----
RAG_PUBLIC_ORIGIN=

# ---- 存储目录 ----
RAG_DATA_DIR=
RAG_DB_PATH=
RAG_UPLOAD_DIR=
RAG_MODELS_DIR=

# ---- 嵌入模型 ----
RAG_EMBED_MODEL=
RAG_EMBED_BACKEND=

# ---- 检索与切块 ----
RAG_TOP_K=
RAG_MIN_RELEVANCE_SCORE=
RAG_CHUNK_MAX_TOKENS=
RAG_CHUNK_OVERLAP_TOKENS=

# ---- 限流与并发 ----
RAG_QUERIES_PER_MINUTE=
RAG_MAX_CONCURRENT_LLM=
RAG_LLM_MAX_TOKENS=
RAG_LLM_TEMPERATURE=

# ---- 上传 ----
RAG_MAX_UPLOAD_MB=

# ---- 服务监听 ----
RAG_HOST=
RAG_PORT=

# ---- Hugging Face 镜像（服务器无法直连 HF 时可配，如 https://hf-mirror.com）----
# HF_ENDPOINT=
