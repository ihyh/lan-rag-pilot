# 复制为 .env；填写密钥和初始密码。不要提交 .env。
# 一行 KEY=value，不加外层引号或行尾注释。Windows 安装说明见 docs/WINDOWS.md。

# 本机 Ollama：保留历史兼容变量名
DEEPSEEK_API_KEY=ollama
DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
DEEPSEEK_MODEL=qwen3:4b-instruct
DEEPSEEK_TIMEOUT_S=180
RAG_LLM_TRUSTED_HOSTS=
RAG_LLM_TRUST_ENV_PROXY=0
RAG_READY_PROBE_LLM=1
RAG_READY_PROBE_TTL_S=30
RAG_READY_PROBE_TIMEOUT_S=3
# 必须在真正启动 Ollama 的环境中设置；应用不能修改已运行进程的环境
OLLAMA_KEEP_ALIVE=30m

# 密钥可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
# root 密码仅用于空数据库首次创建用户
RAG_SECRET_KEY=
RAG_ROOT_PASSWORD=
RAG_COOKIE_SECURE=0
RAG_SESSION_TTL_HOURS=12
RAG_PUBLIC_ORIGIN=http://127.0.0.1:8088
RAG_HOST=127.0.0.1
RAG_PORT=8088

# 留空时使用本项目 data/models 目录；不要指向其他运行实例
RAG_DATA_DIR=
RAG_DB_PATH=
RAG_UPLOAD_DIR=
RAG_MODELS_DIR=

# 本地 BGE；自动安装使用 CPU 版 PyTorch
RAG_EMBED_MODEL=models/bge-small-zh-v1.5
RAG_EMBED_BACKEND=st
RAG_EMBED_DEVICE=cpu
RAG_EMBED_BATCH_SIZE=32
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 留空采用应用默认值
RAG_TOP_K=
# 通用词法召回实验；未通过独立验收前保持关闭，重载内存索引即可
RAG_GENERAL_LEXICAL=0
# 唯一首轮重排候选：本地 BAAI/bge-reranker-v2-m3，CPU / batch4；不可用时报错
RAG_RERANK_ENABLED=0
RAG_RERANK_MODEL=models/bge-reranker-v2-m3
# 当前问题 + 2:1 历史辅助语义召回候选；验收前关闭
RAG_HISTORY_AUXILIARY=0
RAG_MIN_RELEVANCE_SCORE=
RAG_CHUNK_MAX_TOKENS=
RAG_CHUNK_OVERLAP_TOKENS=
RAG_QUERIES_PER_MINUTE=
RAG_MAX_CONCURRENT_LLM=
RAG_LLM_MAX_TOKENS=
RAG_LLM_TEMPERATURE=
RAG_MAX_UPLOAD_MB=

# 解析预算与子进程隔离：留空使用默认上限
RAG_PARSE_MAX_UNCOMPRESSED_MB=
RAG_PARSE_MAX_ZIP_ENTRIES=
RAG_PARSE_MAX_COMPRESSION_RATIO=
RAG_PARSE_MAX_UNITS=
RAG_PARSE_MAX_TEXT_CHARS=
RAG_PARSE_MAX_CHUNKS=
RAG_PARSE_ISOLATION=1
RAG_PARSE_TIMEOUT_S=300
# Windows 不保证解析内存硬限制；仍需保留可用内存
RAG_PARSE_MEMORY_MB=2048

# 仅隔离调试可跳过安全检查；正常安装保持关闭
RAG_ALLOW_INSECURE_START=0
# 如下载站连接受限，可在下载进程中设置 HF_ENDPOINT
