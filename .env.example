# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，严禁提交）
# 完整变量说明见 docs/IT_handover.md；非秘密项给出当前离线实验拓扑，密码和密钥保持空白。

# ---- OpenAI 兼容模型接口（当前实验环境为 Windows Ollama）----
# 必须填写 RAG 服务真正能访问到的内网 Ollama 地址。程序在启动时会校验该地址是否属于
# 内网；填公网地址（含历史默认值 https://api.deepseek.com）会被直接拒绝启动。
# 容器内不要写 127.0.0.1（那指向容器自身）；同一 Compose 网络请用服务名，例如 http://ollama:11434/v1
DEEPSEEK_API_KEY=ollama
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=qwen3:1.7b
DEEPSEEK_TIMEOUT_S=180
# 模型主机若是受控内网机、但不属于私有网段或常见内网后缀，列在这里（逗号分隔）
RAG_LLM_TRUSTED_HOSTS=

# ---- 安全 ----
# 会话令牌 HMAC 密钥：python -c "import secrets;print(secrets.token_urlsafe(48))"
RAG_SECRET_KEY=
# root 初始密码：仅在数据库尚无任何用户时用于创建 root
RAG_ROOT_PASSWORD=
RAG_COOKIE_SECURE=
RAG_SESSION_TTL_HOURS=

# ---- 对外地址 ----
RAG_PUBLIC_ORIGIN=

# ---- 存储目录 ----
RAG_DATA_DIR=
RAG_DB_PATH=
RAG_UPLOAD_DIR=
RAG_MODELS_DIR=

# ---- 嵌入模型 ----
# 离线部署请指向已下载到本机的模型目录（Compose 内为 /rag/models/bge-small-zh-v1.5，
# 宿主模式为 models/bge-small-zh-v1.5）。写成 Hugging Face 仓库名时，只有在 HF 缓存
# 已预热、离线命中成功的情况下才能加载；冷缓存 + HF_HUB_OFFLINE=1 会导致 /api/ready 一直 503。
RAG_EMBED_MODEL=/rag/models/bge-small-zh-v1.5
RAG_EMBED_BACKEND=st

# ---- 检索与切块 ----
RAG_TOP_K=
RAG_MIN_RELEVANCE_SCORE=
RAG_CHUNK_MAX_TOKENS=
RAG_CHUNK_OVERLAP_TOKENS=

# ---- 限流与并发 ----
RAG_QUERIES_PER_MINUTE=
RAG_MAX_CONCURRENT_LLM=
RAG_LLM_MAX_TOKENS=
RAG_LLM_TEMPERATURE=

# ---- 上传 ----
RAG_MAX_UPLOAD_MB=

# ---- 服务监听 ----
# 注意：容器内这两个变量不影响实际绑定（由 Dockerfile 的 CMD 固定为 0.0.0.0:8088）；
# 只有宿主模式脚本（setup_linux.sh / scripts/start_local.ps1）会用它们拼 uvicorn 参数。
RAG_HOST=
RAG_PORT=

# ---- 启动安全校验（见 app/config.py 的 validate_or_raise）----
# 默认关闭。置 1 会跳过密钥缺失 / 模型地址非内网 / Cookie 与来源不匹配的启动校验，
# 仅可用于本机调试，禁止用于共享或企业环境。
RAG_ALLOW_INSECURE_START=

# ---- Hugging Face 镜像（服务器无法直连 HF 时可配，如 https://hf-mirror.com）----
# HF_ENDPOINT=
